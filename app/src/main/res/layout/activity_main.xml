<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#071421">
<LinearLayout android:orientation="vertical" android:padding="18dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="WolFox" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold" android:gravity="center" android:padding="18dp"/>
<TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="جاهز" android:textColor="#90CAF9" android:textSize="17sp" android:gravity="center" android:padding="14dp"/>
<Button android:id="@+id/location" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="الموقع"/>
<Button android:id="@+id/camera" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="الصور والكاميرا"/>
<Button android:id="@+id/bluetooth" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bluetooth"/>
<Button android:id="@+id/target" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="التطبيق المستهدف"/>
</LinearLayout></ScrollView>